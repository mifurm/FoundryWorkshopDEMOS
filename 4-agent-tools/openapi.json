{
  "openapi": "3.0.3",
  "info": {
    "title": "Workshop pricing",
    "version": "1.0.0",
    "description": "Read-only demo pricing. No bookings or payments are made."
  },
  "servers": [{"url": "https://replace-with-bicep-toolEndpoint"}],
  "paths": {
    "/workshop-price": {
      "get": {
        "operationId": "getWorkshopPrice",
        "description": "Get the USD workshop price for 1 to 999 attendees. Always call this operation rather than guessing prices.",
        "parameters": [{
          "name": "attendees",
          "in": "query",
          "required": true,
          "schema": {"type": "integer", "minimum": 1, "maximum": 999}
        }],
        "responses": {
          "200": {
            "description": "Workshop price",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["attendees", "currency", "pricePerAttendee", "total", "source"],
                  "properties": {
                    "attendees": {"type": "integer"},
                    "currency": {"type": "string"},
                    "pricePerAttendee": {"type": "integer"},
                    "total": {"type": "integer"},
                    "source": {"type": "string"}
                  }
                }
              }
            }
          },
          "400": {"description": "Invalid attendee count"}
        }
      }
    }
  }
}
